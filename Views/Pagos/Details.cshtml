@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Pago

@{
    ViewData["Title"] = $"Detalles del Pago #{Model.NumeroPago}";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-warning"></i>Comprobante de Pago #@Model.NumeroPago</h4>
                <span class="badge @(Model.Estado == "Activo" ? "bg-success" : "bg-danger") fs-6">
                    @Model.Estado
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="text-muted fw-bold mb-3"><i class="bi bi-calendar-event me-2"></i>Datos de la Reserva</h6>
                            <p class="mb-1"><strong>Reserva:</strong> #@Model.IdReserva</p>
                            <p class="mb-1"><strong>Inquilino:</strong> @Model.Reserva?.Inquilino?.Nombre @Model.Reserva?.Inquilino?.Apellido</p>
                            <p class="mb-1"><strong>Inmueble:</strong> @Model.Reserva?.Inmueble?.Direccion</p>
                            <p class="mb-0"><strong>Período:</strong> @Model.Reserva?.FechaDesde.ToString("dd/MM/yyyy") al @Model.Reserva?.FechaHasta.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="text-muted fw-bold mb-3"><i class="bi bi-cash-stack me-2"></i>Información del Pago</h6>
                            <p class="mb-1"><strong>N° de Pago:</strong> #@Model.NumeroPago</p>
                            <p class="mb-1"><strong>Fecha de Pago:</strong> @Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Importe:</strong> <span class="text-success fw-bold fs-5">$@Model.Importe.ToString("N2")</span></p>
                            <p class="mb-0"><strong>Concepto:</strong> @Model.Concepto</p>
                        </div>
                    </div>
                </div>

                @if (User.IsInRole("Administrador"))
                {
                    <div class="card border-warning mb-4">
                        <div class="card-header bg-warning bg-opacity-25 py-2 fw-bold text-dark">
                            <i class="bi bi-shield-lock-fill text-warning me-2"></i>Auditoría del Sistema (Visible solo para Administradores)
                        </div>
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Usuario que Registró el Pago:</small>
                                    <strong>@(Model.UsuarioCreador != null ? $"{Model.UsuarioCreador.Nombre} {Model.UsuarioCreador.Apellido} ({Model.UsuarioCreador.Email})" : "No registrado / Semilla")</strong>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Estado de Anulación:</small>
                                    @if (Model.Estado == "Anulado")
                                    {
                                        <div class="text-danger fw-semibold">
                                            Anulado por: @(Model.UsuarioAnulador != null ? $"{Model.UsuarioAnulador.Nombre} {Model.UsuarioAnulador.Apellido}" : "Admin")
                                            <br /><span class="small text-muted">Fecha: @Model.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">Pago activo (no anulado)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        <a asp-action="PorReserva" asp-route-id="@Model.IdReserva" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Ver Pagos de Reserva
                        </a>
                        <a asp-action="Index" class="btn btn-outline-dark">
                            <i class="bi bi-list-ul me-1"></i> Listado General
                        </a>
                    </div>
                    <div class="d-flex gap-2">
                        @if (Model.Estado == "Activo")
                        {
                            <a asp-action="Edit" asp-route-id="@Model.IdPago" class="btn btn-warning">
                                <i class="bi bi-pencil me-1"></i> Modificar Concepto
                            </a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-action="Anular" asp-route-id="@Model.IdPago" class="btn btn-danger">
                                    <i class="bi bi-x-octagon me-1"></i> Anular Pago
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
