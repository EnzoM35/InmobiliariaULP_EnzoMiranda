@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.ListaPaginada<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Pago>

@{
    ViewData["Title"] = "Gestión de Pagos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-cash-coin text-success me-2"></i>Gestión de Pagos</h2>
        <p class="text-muted small mb-0">Control de cobros, señas, cuotas y auditoría financiera</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Registrar Nuevo Pago
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="filtro" value="@ViewBag.Filtro" class="form-control border-start-0" 
                           placeholder="Buscar por concepto, inquilino, inmueble o N° de reserva..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100"><i class="bi bi-funnel me-1"></i> Filtrar</button>
                @if (!string.IsNullOrEmpty(ViewBag.Filtro as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">N° Pago</th>
                        <th>Reserva</th>
                        <th>Inquilino / Inmueble</th>
                        <th>Fecha</th>
                        <th>Importe</th>
                        <th>Concepto</th>
                        <th>Estado</th>
                        @if (User.IsInRole("Administrador"))
                        {
                            <th>Registrado por</th>
                        }
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr class="@(item.Estado == "Anulado" ? "table-light text-muted opacity-75" : "")">
                                <td class="ps-3 fw-bold">#@item.NumeroPago</td>
                                <td>
                                    <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.IdReserva" class="badge bg-light text-dark border text-decoration-none">
                                        <i class="bi bi-calendar3 me-1"></i>Reserva #@item.IdReserva
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.Reserva?.Inquilino?.Nombre @item.Reserva?.Inquilino?.Apellido</div>
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@item.Reserva?.Inmueble?.Direccion</div>
                                </td>
                                <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-success">$@item.Importe.ToString("N2")</td>
                                <td>@item.Concepto</td>
                                <td>
                                    @if (item.Estado == "Activo")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Anulado</span>
                                    }
                                </td>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <td class="small">
                                        @(item.UsuarioCreador != null ? $"{item.UsuarioCreador.Nombre} {item.UsuarioCreador.Apellido}" : "â€”")
                                    </td>
                                }
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IdPago" class="btn btn-outline-info" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Estado == "Activo")
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.IdPago" class="btn btn-outline-warning" title="Editar Concepto">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a asp-action="Anular" asp-route-id="@item.IdPago" class="btn btn-outline-danger" title="Anular Pago">
                                                    <i class="bi bi-x-octagon"></i>
                                                </a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Administrador") ? 9 : 8)" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No se encontraron pagos registrados con los criterios especificados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Mostrando página @Model.Pagina de @Model.TotalPaginas (@Model.Total registros)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.TienePaginaAnterior ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-filtro="@Model.Filtro">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-filtro="@Model.Filtro">@i</a>
                    </li>
                }
                <li class="page-item @(Model.TienePaginaSiguiente ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-filtro="@Model.Filtro">Siguiente</a>
                </li>
            </ul>
        </div>
    }
</div>
