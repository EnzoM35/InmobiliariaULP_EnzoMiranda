@model IList<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Pago>

@{
    var reserva = ViewBag.Reserva as Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Reserva;
    ViewData["Title"] = $"Pagos de Reserva #{reserva?.IdReserva}";

    decimal totalAbonado = Model?.Where(p => p.Estado == "Activo").Sum(p => p.Importe) ?? 0;
    decimal montoTotal = reserva != null ? (reserva.MontoTotal + reserva.Multa) : 0;
    decimal saldo = montoTotal - totalAbonado;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Reservas" asp-action="Index">Reservas</a></li>
                <li class="breadcrumb-item"><a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva?.IdReserva">Reserva #@reserva?.IdReserva</a></li>
                <li class="breadcrumb-item active">Pagos</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-wallet2 text-primary me-2"></i>Pagos de la Reserva #@reserva?.IdReserva
        </h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-idReserva="@reserva?.IdReserva" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Registrar Pago
        </a>
        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@reserva?.IdReserva" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a Reserva
        </a>
    </div>
</div>

<!-- Tarjetas de Resumen Financiero -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-primary">
            <div class="card-body">
                <div class="text-muted small fw-semibold">MONTO RESERVA</div>
                <div class="fs-4 fw-bold text-primary mt-1">$@reserva?.MontoTotal.ToString("N2")</div>
                @if (reserva?.Multa > 0)
                {
                    <div class="small text-danger fw-semibold">+ Multa: $@reserva.Multa.ToString("N2")</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-info">
            <div class="card-body">
                <div class="text-muted small fw-semibold">SEÑA MÍNIMA (@(reserva?.Inmueble?.PorcentajeReserva ?? 10)%)</div>
                <div class="fs-4 fw-bold text-info mt-1">$@reserva?.MontoMinimoSenia.ToString("N2")</div>
                <div class="small text-muted">Para confirmar estadía</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 border-success">
            <div class="card-body">
                <div class="text-muted small fw-semibold">TOTAL ABONADO</div>
                <div class="fs-4 fw-bold text-success mt-1">$@totalAbonado.ToString("N2")</div>
                <div class="small text-muted">@Model?.Count(p => p.Estado == "Activo") pago(s) activos</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-3 bg-white border-start border-4 @(saldo <= 0 ? "border-success" : "border-warning")">
            <div class="card-body">
                <div class="text-muted small fw-semibold">SALDO PENDIENTE</div>
                <div class="fs-4 fw-bold @(saldo <= 0 ? "text-success" : "text-warning") mt-1">
                    $@(saldo > 0 ? saldo.ToString("N2") : "0.00")
                </div>
                <div class="small @(saldo <= 0 ? "text-success fw-semibold" : "text-muted")">
                    @(saldo <= 0 ? "¡Completamente pagada!" : "Pendiente de cobro")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ficha de la Reserva Asociada -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <small class="text-muted d-block">Inquilino</small>
                <strong>@reserva?.Inquilino?.Nombre @reserva?.Inquilino?.Apellido</strong>
                <span class="d-block text-muted small">DNI: @reserva?.Inquilino?.Dni &bull; Tel: @reserva?.Inquilino?.Telefono</span>
            </div>
            <div class="col-md-5">
                <small class="text-muted d-block">Inmueble</small>
                <strong>@reserva?.Inmueble?.Direccion</strong>
                <span class="d-block text-muted small">@reserva?.Inmueble?.Tipo?.Descripcion &bull; $@reserva?.PrecioPorDia.ToString("N2") / noche</span>
            </div>
            <div class="col-md-3 text-md-end">
                <small class="text-muted d-block">Período de Estadía</small>
                <strong>@reserva?.FechaDesde.ToString("dd/MM/yyyy") al @reserva?.FechaHasta.ToString("dd/MM/yyyy")</strong>
                <span class="d-block badge bg-secondary mt-1">@reserva?.Estado</span>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Pagos -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0"><i class="bi bi-receipt me-2 text-primary"></i>Comprobantes de Pago Registrados</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">N° Pago</th>
                        <th>Fecha</th>
                        <th>Importe</th>
                        <th>Concepto</th>
                        <th>Estado</th>
                        @if (User.IsInRole("Administrador"))
                        {
                            <th>Auditoría (Creador / Anulador)</th>
                        }
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.Estado == "Anulado" ? "table-light text-muted opacity-75" : "")">
                                <td class="ps-3 fw-bold">#@item.NumeroPago</td>
                                <td>@item.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-success">$@item.Importe.ToString("N2")</td>
                                <td>@item.Concepto</td>
                                <td>
                                    @if (item.Estado == "Activo")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Anulado</span>
                                    }
                                </td>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <td class="small">
                                        <div><i class="bi bi-person-plus text-primary me-1"></i>@(item.UsuarioCreador != null ? $"{item.UsuarioCreador.Nombre} {item.UsuarioCreador.Apellido}" : "â€”")</div>
                                        @if (item.Estado == "Anulado" && item.UsuarioAnulador != null)
                                        {
                                            <div class="text-danger"><i class="bi bi-x-circle me-1"></i>Por: @item.UsuarioAnulador.Nombre (@item.FechaAnulacion?.ToString("dd/MM/yyyy"))</div>
                                        }
                                    </td>
                                }
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.IdPago" class="btn btn-outline-info" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Estado == "Activo")
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.IdPago" class="btn btn-outline-warning" title="Editar Concepto">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a asp-action="Anular" asp-route-id="@item.IdPago" class="btn btn-outline-danger" title="Anular Pago">
                                                    <i class="bi bi-x-octagon"></i>
                                                </a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Administrador") ? 7 : 6)" class="text-center py-5 text-muted">
                                <i class="bi bi-cash-stack display-6 d-block mb-2"></i>
                                Aún no se han registrado pagos para esta reserva.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

