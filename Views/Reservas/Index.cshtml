@model IEnumerable<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Gestión de Reservas</h2>
        <p class="text-muted small mb-0">Administración de estadías temporales, check-in, cobros y rescisiones</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">#</th>
                        <th>Inmueble</th>
                        <th>Inquilino</th>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Días</th>
                        <th>Monto Total</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@item.IdReserva</td>
                                <td>
                                    <div class="fw-semibold">@item.Inmueble?.Direccion</div>
                                    <small class="text-muted">@item.Inmueble?.Tipo?.Descripcion</small>
                                </td>
                                <td>
                                    <div>@item.Inquilino?.Nombre @item.Inquilino?.Apellido</div>
                                    <small class="text-muted">DNI: @item.Inquilino?.Dni</small>
                                </td>
                                <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                                <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-light text-dark border">@item.CantidadDias d</span></td>
                                <td class="fw-bold text-success">$@item.MontoTotal.ToString("N2")</td>
                                <td>
                                    @if (item.Estado == "Vigente")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Vigente</span>
                                    }
                                    else if (item.Estado == "Terminada anticipadamente")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Terminada ant.</span>
                                    }
                                    else if (item.Estado == "Finalizada")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Finalizada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@item.Estado</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Botón de Pagos -->
                                        <a asp-controller="Pagos" asp-action="PorReserva" asp-route-id="@item.IdReserva" class="btn btn-outline-success" title="Cobros y Pagos">
                                            <i class="bi bi-cash-coin"></i>
                                        </a>

                                        <!-- Detalles -->
                                        <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-outline-info" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (item.Estado == "Vigente")
                                        {
                                            <!-- Terminar anticipadamente -->
                                            <a asp-action="Terminar" asp-route-id="@item.IdReserva" class="btn btn-outline-danger" title="Terminar Anticipadamente con Multa">
                                                <i class="bi bi-calendar-x"></i>
                                            </a>

                                            <!-- Renovar -->
                                            <a asp-action="Renovar" asp-route-id="@item.IdReserva" class="btn btn-outline-primary" title="Renovar / Extender Estadía">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </a>

                                            <!-- Editar -->
                                            <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        <!-- Borrar (Solo Administrador) -->
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-outline-danger" title="Anular Reserva">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-6 d-block mb-2"></i>
                                No hay reservas registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
