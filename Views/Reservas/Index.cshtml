@model IEnumerable<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Listado de Reservas</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Reserva
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Inmueble</th>
                    <th>Inquilino</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Días</th>
                    <th>Monto Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@item.IdReserva</td>
                    <td>
                        <strong>@item.Inmueble?.Direccion</strong>
                        <br />
                        <small class="text-muted">@item.Inmueble?.Tipo?.Descripcion</small>
                    </td>
                    <td>
                        @item.Inquilino?.Nombre @item.Inquilino?.Apellido
                        <br />
                        <small class="text-muted">DNI: @item.Inquilino?.Dni</small>
                    </td>
                    <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>@item.CantidadDias días</td>
                    <td><strong>@item.MontoTotal.ToString("C")</strong></td>
                    <td>
                        @if(item.Estado == "Vigente") {
                            <span class="badge bg-success">Vigente</span>
                        } else if(item.Estado == "Finalizada") {
                            <span class="badge bg-primary">Finalizada</span>
                        } else {
                            <span class="badge bg-secondary">@item.Estado</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-info text-white">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-sm btn-danger">Borrar</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
