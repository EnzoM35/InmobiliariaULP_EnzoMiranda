@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Reserva

@{
    ViewData["Title"] = "Detalles de la Reserva";
}

<h1>Detalles de la Reserva</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Reserva #@Model.IdReserva</h5>
                <span class="badge @(Model.Estado == "Vigente" ? "bg-success" : "bg-secondary")">
                    @Model.Estado
                </span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2">Información del Período y Costo</h6>
                        <dl class="row">
                            <dt class="col-sm-5">Fecha Desde</dt>
                            <dd class="col-sm-7">@Model.FechaDesde.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-5">Fecha Hasta</dt>
                            <dd class="col-sm-7">@Model.FechaHasta.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-5">Duración</dt>
                            <dd class="col-sm-7">@Model.CantidadDias días</dd>

                            <dt class="col-sm-5">Precio por Día</dt>
                            <dd class="col-sm-7">@Model.PrecioPorDia.ToString("C")</dd>

                            <dt class="col-sm-5">Monto Total</dt>
                            <dd class="col-sm-7"><strong class="text-primary fs-5">@Model.MontoTotal.ToString("C")</strong></dd>

                            @if(Model.FechaTerminacion.HasValue)
                            {
                                <dt class="col-sm-5">Terminación</dt>
                                <dd class="col-sm-7">@Model.FechaTerminacion.Value.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-5">Multa</dt>
                                <dd class="col-sm-7 text-danger"><strong>@Model.Multa.ToString("C")</strong></dd>
                            }
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2">Inquilino</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Nombre</dt>
                            <dd class="col-sm-8">@Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</dd>

                            <dt class="col-sm-4">DNI</dt>
                            <dd class="col-sm-8">@Model.Inquilino?.Dni</dd>

                            <dt class="col-sm-4">Teléfono</dt>
                            <dd class="col-sm-8">@(Model.Inquilino?.Telefono ?? "-")</dd>

                            <dt class="col-sm-4">Email</dt>
                            <dd class="col-sm-8">@Model.Inquilino?.Email</dd>
                        </dl>

                        <h6 class="text-muted border-bottom pb-2 mt-3">Inmueble Alquilado</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Dirección</dt>
                            <dd class="col-sm-8"><strong>@Model.Inmueble?.Direccion</strong></dd>

                            <dt class="col-sm-4">Tipo</dt>
                            <dd class="col-sm-8">@Model.Inmueble?.Tipo?.Descripcion</dd>

                            <dt class="col-sm-4">Propietario</dt>
                            <dd class="col-sm-8">@Model.Inmueble?.Duenio?.Nombre @Model.Inmueble?.Duenio?.Apellido</dd>
                        </dl>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.IdReserva" class="btn btn-warning">Editar Reserva</a>
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </div>
        </div>
    </div>
</div>
