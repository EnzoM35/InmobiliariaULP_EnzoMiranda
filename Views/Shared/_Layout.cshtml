<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inmobiliaria ULP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building-fill text-warning"></i>
                    <span>Inmobiliaria ULP</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Propietarios" asp-action="Index"><i class="bi bi-person-badge me-1"></i>Propietarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Inquilinos" asp-action="Index"><i class="bi bi-people me-1"></i>Inquilinos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TiposInmueble" asp-action="Index"><i class="bi bi-tags me-1"></i>Tipos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Inmuebles" asp-action="Index"><i class="bi bi-houses me-1"></i>Inmuebles</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="Index"><i class="bi bi-calendar-check me-1"></i>Reservas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Pagos" asp-action="Index"><i class="bi bi-cash-coin me-1"></i>Pagos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Informes" asp-action="Index"><i class="bi bi-graph-up-arrow me-1"></i>Informes</a>
                            </li>
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-shield-lock me-1"></i>Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                            var role = User.IsInRole("Administrador") ? "Administrador" : "Empleado";
                            var avatar = User.FindFirst("AvatarUrl")?.Value;

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(avatar) && avatar != "/img/default-avatar.png")
                                    {
                                        <img src="@avatar" alt="Avatar" class="rounded-circle border border-warning" style="width: 32px; height: 32px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @(fullName?.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                    }
                                    <div class="text-start lh-1">
                                        <div class="fw-semibold small">@fullName</div>
                                        <span class="badge @(role == "Administrador" ? "bg-warning text-dark" : "bg-info text-dark")" style="font-size: 0.65rem;">@role</span>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Usuarios" asp-action="Perfil">
                                            <i class="bi bi-person-gear"></i> Mi Perfil
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Usuarios" asp-action="Index">
                                                <i class="bi bi-shield-check"></i> Panel Usuarios
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Usuarios" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-warning btn-sm px-3" asp-controller="Usuarios" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-muted bg-white mt-auto">
        <div class="container text-center small">
            &copy; 2026 - Inmobiliaria ULP &bull; Gestión Inmobiliaria Integral &bull; Enzo Miranda
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
