@model IEnumerable<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Listado de Inmuebles</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Publicar Nuevo Inmueble
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.IdInmueble)</th>
                    <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                    <th>Tipo</th>
                    <th>Propietario</th>
                    <th>@Html.DisplayNameFor(model => model.Cupo)</th>
                    <th>@Html.DisplayNameFor(model => model.PrecioDia)</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdInmueble)</td>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.Direccion)</strong>
                    </td>
                    <td>
                        <span class="badge bg-secondary">@item.Tipo?.Descripcion</span>
                    </td>
                    <td>
                        @item.Duenio?.Nombre @item.Duenio?.Apellido
                    </td>
                    <td>
                        @item.Cupo pers.
                    </td>
                    <td>
                        <strong>@item.PrecioDia.ToString("C")</strong>
                    </td>
                    <td>
                        @if(item.Disponible) {
                            <span class="badge bg-success">Disponible</span>
                        } else {
                            <span class="badge bg-danger">Suspendido</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-info text-white">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-danger">Borrar</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
