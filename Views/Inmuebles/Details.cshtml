@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Inmueble

@{
    ViewData["Title"] = "Detalles del Inmueble";
}

<h1>Detalles del Inmueble</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Model.Direccion</h5>
                <span class="badge @(Model.Disponible ? "bg-success" : "bg-danger")">
                    @(Model.Disponible ? "Disponible" : "Suspendido")
                </span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2">Información de la Propiedad</h6>
                        <dl class="row">
                            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.IdInmueble)</dt>
                            <dd class="col-sm-7">#@Model.IdInmueble</dd>

                            <dt class="col-sm-5">Tipo</dt>
                            <dd class="col-sm-7"><span class="badge bg-secondary">@Model.Tipo?.Descripcion</span></dd>

                            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Cupo)</dt>
                            <dd class="col-sm-7">@Model.Cupo personas</dd>

                            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.PrecioDia)</dt>
                            <dd class="col-sm-7"><strong>@Model.PrecioDia.ToString("C")</strong></dd>

                            <dt class="col-sm-5">@Html.DisplayNameFor(model => model.PorcentajeReserva)</dt>
                            <dd class="col-sm-7">@Model.PorcentajeReserva %</dd>

                            <dt class="col-sm-5">Coordenadas</dt>
                            <dd class="col-sm-7">
                                @(Model.Latitud.HasValue && Model.Longitud.HasValue ? $"{Model.Latitud}, {Model.Longitud}" : "No especificadas")
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted border-bottom pb-2">Datos del Propietario</h6>
                        <dl class="row">
                            <dt class="col-sm-5">Nombre</dt>
                            <dd class="col-sm-7">@Model.Duenio?.Nombre @Model.Duenio?.Apellido</dd>

                            <dt class="col-sm-5">DNI</dt>
                            <dd class="col-sm-7">@Model.Duenio?.Dni</dd>

                            <dt class="col-sm-5">Teléfono</dt>
                            <dd class="col-sm-7">@(Model.Duenio?.Telefono ?? "-")</dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7">@Model.Duenio?.Email</dd>
                        </dl>
                    </div>
                </div>

                @if(!string.IsNullOrEmpty(Model.Portada))
                {
                    <div class="mt-3">
                        <h6 class="text-muted border-bottom pb-2">Foto de Portada</h6>
                        <p class="text-muted small">Ruta: @Model.Portada</p>
                    </div>
                }

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.IdInmueble" class="btn btn-warning">Editar Inmueble</a>
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </div>
        </div>
    </div>
</div>
