@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
    var propietarios = ViewBag.Propietarios as IList<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Propietario> ?? new List<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Propietario>();
    var tipos = ViewBag.TiposInmueble as IList<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.TipoInmueble> ?? new List<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.TipoInmueble>();
}

<h1>Editar Inmueble</h1>
<hr />
<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @if(ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }
                    <input type="hidden" asp-for="IdInmueble" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="IdTipoInmueble" class="form-label"></label>
                            <select asp-for="IdTipoInmueble" class="form-select">
                                @foreach (var tipo in tipos)
                                {
                                    <option value="@tipo.IdTipoInmueble" selected="@(tipo.IdTipoInmueble == Model.IdTipoInmueble)">@tipo.Descripcion</option>
                                }
                            </select>
                            <span asp-validation-for="IdTipoInmueble" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="IdPropietario" class="form-label"></label>
                            <select asp-for="IdPropietario" class="form-select">
                                @foreach (var prop in propietarios)
                                {
                                    <option value="@prop.IdPropietario" selected="@(prop.IdPropietario == Model.IdPropietario)">@prop.Nombre @prop.Apellido (DNI: @prop.Dni)</option>
                                }
                            </select>
                            <span asp-validation-for="IdPropietario" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Cupo" class="form-label"></label>
                            <input asp-for="Cupo" type="number" class="form-control" min="1" />
                            <span asp-validation-for="Cupo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrecioDia" class="form-label"></label>
                            <input asp-for="PrecioDia" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="PrecioDia" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PorcentajeReserva" class="form-label"></label>
                            <input asp-for="PorcentajeReserva" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Latitud" class="form-label"></label>
                            <input asp-for="Latitud" type="number" step="any" class="form-control" />
                            <span asp-validation-for="Latitud" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Longitud" class="form-label"></label>
                            <input asp-for="Longitud" type="number" step="any" class="form-control" />
                            <span asp-validation-for="Longitud" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Portada" class="form-label"></label>
                            <input asp-for="Portada" class="form-control" />
                            <span asp-validation-for="Portada" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3 d-flex align-items-center mt-3">
                            <div class="form-check form-switch">
                                <input asp-for="Disponible" class="form-check-input" type="checkbox" />
                                <label asp-for="Disponible" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
