@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.ListaPaginada<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.Usuario>
@{
    ViewData["Title"] = "GestiÃ³n de Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people"></i> GestiÃ³n de Usuarios</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nuevo Usuario</a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="text" name="filtro" value="@Model.Filtro" class="form-control" placeholder="Buscar por nombre, email, rol..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i> Buscar</button>
            @if (!string.IsNullOrEmpty(Model.Filtro))
            {
                <a asp-action="Index" class="btn btn-link">Limpiar</a>
            }
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Avatar</th>
                        <th>Nombre y Apellido</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.AvatarUrl) ? "/img/default-avatar.png" : item.AvatarUrl)" 
                                     class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="Avatar" />
                            </td>
                            <td class="fw-semibold">@item.Nombre @item.Apellido</td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge @(item.Rol == "Administrador" ? "bg-danger" : "bg-primary")">
                                    @item.Rol
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-info text-white"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PaginaciÃ³n -->
    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.TienePaginaAnterior ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina - 1)" asp-route-filtro="@Model.Filtro">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.Pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-filtro="@Model.Filtro">@i</a>
                    </li>
                }
                <li class="page-item @(Model.TienePaginaSiguiente ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.Pagina + 1)" asp-route-filtro="@Model.Filtro">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>