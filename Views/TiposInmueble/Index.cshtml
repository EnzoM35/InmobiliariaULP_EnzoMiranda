@model IEnumerable<Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tipos de Inmueble</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Tipo
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.IdTipoInmueble)</th>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.IdTipoInmueble)</td>
                    <td><strong>@Html.DisplayFor(modelItem => item.Descripcion)</strong></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-info text-white">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.IdTipoInmueble" class="btn btn-sm btn-danger">Borrar</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
