@model Laboratorio_II___Proyecto_Inmobiliaria_EnzoMiranda.Models.TipoInmueble

@{
    ViewData["Title"] = "Borrar Tipo de Inmueble";
}

<h1>Borrar Tipo de Inmueble</h1>

<div class="alert alert-warning col-md-6">
    <h5>¿Está seguro que desea eliminar este tipo de inmueble?</h5>
    <p class="mb-0">El registro se desactivará lógicamente del sistema.</p>
</div>

<div class="card shadow-sm col-md-6">
    <div class="card-body">
        @if(ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.IdTipoInmueble)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.IdTipoInmueble)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdTipoInmueble" />
            <div class="d-flex gap-2">
                <input type="submit" value="Confirmar Borrado" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
